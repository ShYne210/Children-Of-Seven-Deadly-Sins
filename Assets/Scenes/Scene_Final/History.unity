  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "21/10/20xx\n\nhom nay minh di kham benh cung me luc dau minh hoi so vi
    benh vien dong nguoi va mui thuoc sat trung khong thich chut nao minh nam tay
    me\n\nnhung bac si noi chuyen rat nhe nhang bac si cuoi voi minh lam minh thay
    do so hon bac si hoi minh co dau khong va bao minh ngoan nen minh se som binh
    phuc\n\nLuc bac si noi vay minh thay vui lam va minh nghi bac si la nguoi tot
    bung lam nen moi noi chuyen nhe nhang nhu vay \n\nVe nha roi ma minh van nho
    den bac si va cu tu hoi sau nay minh co the tro thanh bac si duoc khong  minh
    muon mac ao trang va giup moi nguoi de moi nguoi khong con so giong minh nua\n\nMinh
    ma duoc tro thanh bac si chac se hanh phuc lam"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
