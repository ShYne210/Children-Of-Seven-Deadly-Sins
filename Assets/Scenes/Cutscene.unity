--- !u!114 &1122967323
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1122967318}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d13ad9b9f4d13c40b90905d7b6f972c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogPanel: {fileID: 800166671}
  choicePanel: {fileID: 373161391}
  dialogText: {fileID: 1814361098}
  choiceText1: {fileID: 1750789886}
  choiceText2: {fileID: 1289144634}
  btnNext: {fileID: 328931777}
  btnAuto: {fileID: 1799473375}
  btnChoice1: {fileID: 2064440367}
  btnChoice2: {fileID: 1304669202}
  cutsceneBGM: {fileID: 0}
  mainDialogs:
  - "(T\u1ED1i \u0111\u1EBFn m\u1EE9c ngay c\u1EA3 \xFD ngh\u0129 c\u0169ng kh\xF4ng
    c\xF2n h\xECnh d\u1EA1ng.)"
  - "Th\u1EA7n: Ng\u01B0\u01A1i c\xF3 nghe th\u1EA5y ch\xFAng kh\xF4ng?"
  - "Th\u1EA7n: Nh\u1EEFng ti\u1EBFng kh\xF3c r\u1EA5t nh\u1ECF.\nB\u1ECB b\xF3p
    ngh\u1EB9t sau nh\u1EEFng c\xE1nh c\u1EEDa \u0111\xF3ng k\xEDn."
  - "Th\u1EA7n: B\u1EA3y \u0111\u1EE9a tr\u1EBB."
  - "Th\u1EA7n: B\u1EA3y c\u0103n ph\xF2ng."
  - "Th\u1EA7n: V\xE0 b\u1EA3y t\u1ED9i l\u1ED7i \u0111ang nu\xF4i d\u01B0\u1EE1ng
    n\u1ED7i \u0111au c\u1EE7a ch\xFAng m\u1ED7i ng\xE0y."
  - "Th\u1EA7n: Ki\xEAu ng\u1EA1o, Ghen t\u1ECB, Ph\u1EABn n\u1ED9, Tham lam, L\u01B0\u1EDDi
    bi\u1EBFng,\nD\u1EE5c v\u1ECDng, Ph\xE0m \u0103n.\n"
  - "Th\u1EA7n: Cha m\u1EB9 c\u1EE7a ch\xFAng kh\xF4ng ph\u1EA3i qu\xE1i v\u1EADt.\nH\u1ECD
    ch\u1EC9 l\xE0 nh\u1EEFng k\u1EBB ch\u01B0a bao gi\u1EDD d\xE1m \u0111\u1ED1i
    di\u1EC7n v\u1EDBi ch\xEDnh m\xECnh.\n"
  - "Th\u1EA7n: Ng\u01B0\u01A1i s\u1EBD b\u01B0\u1EDBc v\xE0o t\u1EEBng k\xFD \u1EE9c.\nH\xF3a
    th\xE2n th\xE0nh t\u1EEBng \u0111\u1EE9a tr\u1EBB.\n"
  - "Th\u1EA7n: Ng\u01B0\u01A1i s\u1EBD b\u01B0\u1EDBc v\xE0o t\u1EEBng k\xFD \u1EE9c.\nH\xF3a
    th\xE2n th\xE0nh t\u1EEBng \u0111\u1EE9a tr\u1EBB.\n"
  - "Th\u1EA7n: C\u1EA3m nh\u1EADn n\u1ED7i s\u1EE3 c\u1EE7a ch\xFAng.\nN\u1ED7i
    im l\u1EB7ng c\u1EE7a ch\xFAng.\nN\u1ED7i c\xF4 \u0111\u1ED9c c\u1EE7a ch\xFAng.\n"
  - "Th\u1EA7n: V\xE0 gi\u1EA3i c\u1EE9u ch\xFAng kh\u1ECFi chi\u1EBFc b\xF3ng c\u1EE7a
    cha m\u1EB9 m\xECnh.\n"
  - "Th\u1EA7n: Nh\u01B0ng h\xE3y nh\u1EDB k\u1EF9 m\u1ED9t \u0111i\u1EC1u."
  - "Th\u1EA7n: M\u1ED7i c\u0103n ph\xF2ng ng\u01B0\u01A1i b\u01B0\u1EDBc v\xE0o\u2026"
  - "Th\u1EA7n: s\u1EBD ph\u1EA3n chi\u1EBFu l\u1EA1i m\u1ED9t ph\u1EA7n qu\xE1 kh\u1EE9
    c\u1EE7a ch\xEDnh ng\u01B0\u01A1i."
  - "Th\u1EA7n: B\u1EDFi v\xEC trong cu\u1ED9c \u0111\u1EDDi m\xECnh, ng\u01B0\u01A1i
    c\u0169ng \u0111\xE3 t\u1EEBng ph\u1EA1m ph\u1EA3i \u0111\u1EE7 c\u1EA3 b\u1EA3y
    t\u1ED9i l\u1ED7i \u0111\xF3."
  - "Th\u1EA7n: V\xEC h\xE8n nh\xE1t. V\xEC y\u1EBFu \u0111u\u1ED1i. V\xEC ham mu\u1ED1n
    \u0111\u01B0\u1EE3c c\xF4ng nh\u1EADn.\nV\xEC s\u1EE3 b\u1ECB b\u1ECF r\u01A1i."
  - "Th\u1EA7n: Ng\u01B0\u01A1i kh\xF4ng kh\xE1c h\u1ECD."
  - "Th\u1EA7n: C\xE2u h\u1ECFi duy nh\u1EA5t l\xE0\u2026 Ng\u01B0\u01A1i c\xF3 \u0111\u1EE7
    can \u0111\u1EA3m \u0111\u1EC3 nh\xECn th\u1EB3ng v\xE0o \u0111i\u1EC1u \u0111\xF3
    kh\xF4ng?"
  explainA:
  - "Th\u1EA7n: Ng\u01B0\u01A1i ngh\u0129 \u0111\xE2y l\xE0 m\u1EC7nh l\u1EC7nh sao?"
  - "Th\u1EA7n: Kh\xF4ng."
  - "Th\u1EA7n: \u0110\xE2y l\xE0 c\u01A1 h\u1ED9i chu\u1ED9c l\u1ED7i."
  - "Th\u1EA7n: Ng\u01B0\u01A1i c\xF2n nh\u1EDB \u0111\u1EE9a tr\u1EBB \u0111\xE3
    t\u1EEBng kh\xF3c trong ph\xF2ng t\u1ED1i kh\xF4ng?"
  - "Th\u1EA7n: Kh\xF4ng ai nghe th\u1EA5y n\xF3."
  - "Th\u1EA7n: Kh\xF4ng ai \u0111\u1EE9ng v\u1EC1 ph\xEDa n\xF3."
  - "Th\u1EA7n: Kh\xF4ng ai \u0111\u1EE9ng v\u1EC1 ph\xEDa n\xF3."
  - "Th\u1EA7n: V\xE0 r\u1ED3i m\u1ED9t ng\xE0y\u2026"
  - "Th\u1EA7n: n\xF3 h\u1ECDc c\xE1ch im l\u1EB7ng."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng ch\u1EE9ng ki\u1EBFn m\u1ED9t
    b\u1EA5t c\xF4ng.\nV\xE0 ng\u01B0\u01A1i \u0111\xE3 quay l\u01B0ng l\u1EA1i."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng ch\u1EE9ng ki\u1EBFn m\u1ED9t
    b\u1EA5t c\xF4ng.\nV\xE0 ng\u01B0\u01A1i \u0111\xE3 quay l\u01B0ng l\u1EA1i."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 s\u1EF1 h\xE8n nh\xE1t."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng ghen t\u1ECB v\u1EDBi h\u1EA1nh
    ph\xFAc c\u1EE7a ng\u01B0\u1EDDi kh\xE1c.\nV\xE0 mong h\u1ECD th\u1EA5t b\u1EA1i."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 \u0111\u1ED1 k\u1EF5."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng n\u1ED5i gi\u1EADn v\xE0 l\xE0m
    t\u1ED5n th\u01B0\u01A1ng ai \u0111\xF3 ch\u1EC9 v\xEC b\u1EA3n th\xE2n t\u1ED5n
    th\u01B0\u01A1ng."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 ph\u1EABn n\u1ED9."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng ch\u1ECDn an to\xE0n thay v\xEC
    \u0111\u1EE9ng l\xEAn b\u1EA3o v\u1EC7 \u0111i\u1EC1u \u0111\xFAng."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 l\u01B0\u1EDDi bi\u1EBFng c\u1EE7a \u0111\u1EA1o
    \u0111\u1EE9c."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng mu\u1ED1n nhi\u1EC1u h\u01A1n
    m\u1EE9c m\xECnh c\u1EA7n."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 tham lam."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng \u0111\xE1nh \u0111\u1ED5i gi\xE1
    tr\u1ECB c\u1EE7a m\xECnh v\xEC ham mu\u1ED1n nh\u1EA5t th\u1EDDi."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 d\u1EE5c v\u1ECDng."
  - "Th\u1EA7n: V\xE0 ng\u01B0\u01A1i \u0111\xE3 t\u1EEBng nu\u1ED1t ch\u1EEDng m\u1ECDi
    c\u1EA3m x\xFAc ti\xEAu c\u1EF1c\nthay v\xEC \u0111\u1ED1i di\u1EC7n v\u1EDBi
    n\xF3."
  - "Th\u1EA7n: \u0110\xF3 l\xE0 s\u1EF1 ph\xE0m \u0103n c\u1EE7a linh h\u1ED3n."
  - "Th\u1EA7n: Ng\u01B0\u01A1i kh\xF4ng nghe l\u1EDDi ta."
  - "Th\u1EA7n: Ng\u01B0\u01A1i kh\xF4ng nghe l\u1EDDi ta."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111ang \u0111\u1ED1i di\u1EC7n v\u1EDBi ch\xEDnh
    m\xECnh."
  - "Th\u1EA7n: Gi\u1EA3i c\u1EE9u nh\u1EEFng \u0111\u1EE9a tr\u1EBB \u1EA5y\nkh\xF4ng
    ch\u1EC9 \u0111\u1EC3 c\u1EE9u ch\xFAng, m\xE0 c\u1EE9u c\u1EA3 b\u1EA3n th\xE2n
    ng\u01B0\u01A1i."
  - "Th\u1EA7n: Gi\u1EA3i c\u1EE9u nh\u1EEFng \u0111\u1EE9a tr\u1EBB \u1EA5y\nkh\xF4ng
    ch\u1EC9 \u0111\u1EC3 c\u1EE9u ch\xFAng, m\xE0 c\u1EE9u c\u1EA3 b\u1EA3n th\xE2n
    ng\u01B0\u01A1i."
  - "Th\u1EA7n: C\u1EE9u l\u1EA5y phi\xEAn b\u1EA3n \u0111\xE3 t\u1EEBng y\u1EBFu
    \u0111u\u1ED1i c\u1EE7a ng\u01B0\u01A1i."
  explainB:
  - "Th\u1EA7n: Th\u1EA5t b\u1EA1i?"
  - "Th\u1EA7n: Ng\u01B0\u01A1i ngh\u0129 m\xECnh ch\u01B0a t\u1EEBng th\u1EA5t b\u1EA1i
    sao?"
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 th\u1EA5t b\u1EA1i khi ch\u1ECDn im l\u1EB7ng."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 th\u1EA5t b\u1EA1i khi \u0111\u1EC3 n\u1ED7i
    s\u1EE3 \u0111i\u1EC1u khi\u1EC3n m\xECnh."
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 th\u1EA5t b\u1EA1i khi tr\u1EDF th\xE0nh
    k\u1EBB \u0111\u1EE9ng ngo\xE0i cu\u1ED9c."
  - "Th\u1EA7n: Nh\u01B0ng l\u1EA7n n\xE0y kh\xE1c."
  - "Th\u1EA7n: N\u1EBFu ng\u01B0\u01A1i b\u01B0\u1EDBc v\xE0o k\xFD \u1EE9c c\u1EE7a
    nh\u1EEFng \u0111\u1EE9a tr\u1EBB \u1EA5y\nv\xE0 th\u1EA5t b\u1EA1i\u2026"
  - "Th\u1EA7n: \xCDt nh\u1EA5t ng\u01B0\u01A1i \u0111\xE3 d\xE1m \u0111\u1ED1i di\u1EC7n."
  - "Th\u1EA7n: C\xF2n n\u1EBFu ng\u01B0\u01A1i t\u1EEB ch\u1ED1i?"
  - "Th\u1EA7n: B\u1EA3y \u0111\u1EE9a tr\u1EBB s\u1EBD c\xF3 nh\u1EEFng k\u1EBFt
    c\u1EE5c nh\u01B0 n\xE0o ch\u1EAFc ng\u01B0\u1EDDi c\u0169ng hi\u1EC3u nh\u1EC9
    ?"
  - "Th\u1EA7n: S\u1EBD tr\u1EDF th\xE0nh m\u1ED9t phi\xEAn b\u1EA3n c\u1EE7a ng\u01B0\u1EDDi
    ho\u1EB7c t\u1EC7 h\u01A1n l\xE0 t\u1EC7 n\u1EA1n, l\xE0 c\xE1i ch\u1EBFt."
  - "Th\u1EA7n: S\u1EBD bi\u1EBFn th\xE0nh m\u1ED9t phi\xEAn b\u1EA3n kh\xE1c c\u1EE7a
    cha m\u1EB9 ch\xFAng."
  - "Th\u1EA7n: S\u1EBD bi\u1EBFn th\xE0nh m\u1ED9t phi\xEAn b\u1EA3n kh\xE1c c\u1EE7a
    cha m\u1EB9 ch\xFAng."
  - "Th\u1EA7n: Th\u1EA5t b\u1EA1i kh\xF4ng \u0111\xE1ng s\u1EE3."
  - "Th\u1EA7n: S\u1ED1ng c\u1EA3 \u0111\u1EDDi m\xE0 kh\xF4ng s\u1EEDa sai m\u1EDBi
    \u0111\xE1ng s\u1EE3."
  - "Th\u1EA7n: Ng\u01B0\u01A1i s\u1EE3 r\u1EB1ng m\xECnh kh\xF4ng \u0111\u1EE7 m\u1EA1nh."
  - "Th\u1EA7n: Nh\u01B0ng ta th\u1EA5y \u0111i\u1EC1u kh\xE1c."
  - "Th\u1EA7n: Ta th\u1EA5y m\u1ED9t k\u1EBB \u0111\xE3 m\u1EC7t m\u1ECFi v\u1EDBi
    vi\u1EC7c t\u1EF1 khinh th\u01B0\u1EDDng ch\xEDnh m\xECnh."
  - "Th\u1EA7n: Ta th\u1EA5y m\u1ED9t k\u1EBB \u0111\xE3 m\u1EC7t m\u1ECFi v\u1EDBi
    vi\u1EC7c t\u1EF1 khinh th\u01B0\u1EDDng ch\xEDnh m\xECnh."
  - "Th\u1EA7n: V\xE0 \u0111\xE2y\u2026\nl\xE0 c\u01A1 h\u1ED9i cu\u1ED1i c\xF9ng
    \u0111\u1EC3 thay \u0111\u1ED5i \u0111i\u1EC1u \u0111\xF3."
  acceptDialogs:
  - "Th\u1EA7n: V\u1EADy l\xE0 ng\u01B0\u01A1i \u0111\xE3 ch\u1ECDn b\u01B0\u1EDBc
    v\xE0o b\xF3ng t\u1ED1i."
  - "Th\u1EA7n: T\u1ED1t.\nC\u0103n ph\xF2ng \u0111\u1EA7u ti\xEAn \u0111ang ch\u1EDD
    ng\u01B0\u01A1i."
  - "Th\u1EA7n: Khi ng\u01B0\u1EDDi b\u01B0\u1EDBc qua t\u1EEBng c\xE1nh c\u1EEDa
    ng\u01B0\u01A1i kh\xF4ng ch\u1EC9 nh\xECn th\u1EA5y b\u1ECDn tr\u1EBB."
  - "Th\u1EA7n: Ng\u01B0\u01A1i s\u1EBD tr\u1EDF th\xE0nh ch\xFAng."
  - "Th\u1EA7n: M\u1ED7i l\u1EA7n c\u1EE9u \u0111\u01B0\u1EE3c m\u1ED9t \u0111\u1EE9a
    tr\u1EBB,\nm\u1ED9t ph\u1EA7n t\u1ED9i l\u1ED7i trong ng\u01B0\u01A1i s\u1EBD
    b\u1ECB l\u1ED9t b\u1ECF."
  - "Th\u1EA7n: Nh\u01B0ng qu\xE1 tr\xECnh \u0111\xF3\u2026"
  - "Th\u1EA7n: s\u1EBD \u0111au \u0111\u1EDBn."
  - "Th\u1EA7n: V\xEC ng\u01B0\u01A1i s\u1EBD ph\u1EA3i th\u1EEBa nh\u1EADn r\u1EB1ng\nm\xECnh
    \u0111\xE3 t\u1EEBng gi\u1ED1ng nh\u1EEFng k\u1EBB m\xE0 ng\u01B0\u01A1i c\u0103m
    gh\xE9t."
  - "Th\u1EA7n: \u0110\xE2y kh\xF4ng ph\u1EA3i tr\xF2 ch\u01A1i anh h\xF9ng."
  - "Th\u1EA7n: \u0110\xE2y l\xE0 h\xE0nh tr\xECnh chu\u1ED9c t\u1ED9i."
  - "Th\u1EA7n: V\xE0 t\u1EEB kho\u1EA3nh kh\u1EAFc n\xE0y\u2026"
  - "Th\u1EA7n: Kh\xF4ng c\xF2n \u0111\u01B0\u1EDDng quay l\u1EA1i n\u1EEFa."
  gameOverDialogs:
  - "Th\u1EA7n: Ta hi\u1EC3u r\u1ED3i."
  - "Th\u1EA7n: Ng\u01B0\u01A1i ch\u1ECDn an to\xE0n."
  - "Th\u1EA7n: Gi\u1ED1ng nh\u01B0 l\u1EA7n ng\u01B0\u01A1i ch\u1ECDn im l\u1EB7ng
    khi th\u1EA5y m\u1ED9t \u0111\u1EE9a tr\u1EBB b\u1ECB t\u1ED5n th\u01B0\u01A1ng."
  - "Th\u1EA7n: Gi\u1ED1ng nh\u01B0 l\u1EA7n ng\u01B0\u01A1i ch\u1ECDn b\u1ECF \u0111i
    thay v\xEC xin l\u1ED7i."
  - "Th\u1EA7n: Gi\u1ED1ng nh\u01B0 l\u1EA7n ng\u01B0\u01A1i n\xF3i:\n\u201CKh\xF4ng
    ph\u1EA3i vi\u1EC7c c\u1EE7a m\xECnh.\u201D"
  - "Th\u1EA7n: B\u1EA3y \u0111\u1EE9a tr\u1EBB s\u1EBD ti\u1EBFp t\u1EE5c s\u1ED1ng
    trong b\xF3ng t\u1ED1i."
  - "Th\u1EA7n: V\xE0 ng\u01B0\u01A1i s\u1EBD ti\u1EBFp t\u1EE5c s\u1ED1ng v\u1EDBi
    qu\xE1 kh\u1EE9 c\u1EE7a m\xECnh."
  - "Th\u1EA7n: Kh\xF4ng ai bi\u1EBFt."
  - "Th\u1EA7n: Kh\xF4ng ai nh\u1EAFc \u0111\u1EBFn."
  - "Th\u1EA7n: Nh\u01B0ng m\u1ED7i khi nh\xECn l\u1EA1i\u2026"
  - "Th\u1EA7n: Ng\u01B0\u01A1i s\u1EBD th\u1EA5y \xE1nh m\u1EAFt c\u1EE7a m\u1ED9t
    \u0111\u1EE9a tr\u1EBB\n\u0111ang h\u1ECFi t\u1EA1i sao ng\u01B0\u01A1i kh\xF4ng
    c\u1EE9u n\xF3."
  - "Th\u1EA7n: V\xE0 c\xE2u tr\u1EA3 l\u1EDDi\u2026"
  - "Th\u1EA7n: Ng\u01B0\u01A1i \u0111\xE3 bi\u1EBFt t\u1EEB \u0111\u1EA7u."
  - "Th\u1EA7n: Nh\u01B0ng ng\u01B0\u01A1i kh\xF4ng \u0111\u1EE7 can \u0111\u1EA3m
    \u0111\u1EC3 th\u1EEBa nh\u1EADn."
  - "Th\u1EA7n: Gi\u1EDD th\xEC c\xFAt xu\u1ED1ng d\u01B0\u1EDBi \u0111\u1ECBa ng\u1EE5c
    v\xE0 l\xE0m n\xF4 l\u1EC7 cho l\u0169 qu\u1EF7 \u0111\u1EEF \u0111i."
